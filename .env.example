# 密钥可放三处, 按优先级: 环境变量 > macOS Keychain > 本文件(.env)
#
# - GitHub Actions: 用仓库 Secrets(走环境变量), 不需要 .env
# - 本机运行: 推荐用 macOS Keychain(见 README), 密钥不落明文文件
# - 本文件仅作兜底/快速本地测试; 已被 .gitignore 忽略, 不会进仓库

TELEGRAM_BOT_TOKEN=在此填入你的BotToken
TELEGRAM_CHAT_ID=在此填入你的ChatID

# 非美区 relay(复用 funding-rate-alert 已部署的那个 Render 新加坡 relay)
BINANCE_BASE=https://binance-relay-jaeb.onrender.com
RELAY_TOKEN=在此填入relay鉴权密钥(与relay端一致)

# 微信推送(可选, PushPlus, 不配则只推 Telegram)
PUSHPLUS_TOKEN=在此填入PushPlus的Token
